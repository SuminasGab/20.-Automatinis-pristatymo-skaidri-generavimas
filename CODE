            <!-- Active Slide Editor & Speaker Notes Area -->
            <div class="flex-1 flex flex-col overflow-y-auto p-4 sm:p-6 lg:p-8 gap-5">
                
                <!-- Slide Canvas Controls Header -->
                <div class="max-w-4xl w-full mx-auto flex flex-wrap items-center justify-between gap-2">
                    <div class="flex items-center gap-2">
                        <span id="active-slide-indicator" class="text-xs font-bold px-2.5 py-1 rounded-lg bg-white border border-slate-200 text-slate-700 shadow-2xs">
                            Skaidrė 1 iš 5
