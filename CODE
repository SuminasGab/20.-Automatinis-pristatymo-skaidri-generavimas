            state.activeSlideIndex += 1;
            renderApp();
            showToast('Pridėta nauja skaidrė.', 'info');
        }

        document.getElementById('btn-add-slide').addEventListener('click', addNewSlide);
        document.getElementById('btn-add-slide-top').addEventListener('click', addNewSlide);

        // Move Slide Up / Down / Delete
        btnMoveUp.addEventListener('click', () => {
            const idx = state.activeSlideIndex;
            if (idx > 0) {
                const temp = state.slides[idx - 1];
                state.slides[idx - 1] = state.slides[idx];
                state.slides[idx] = temp;
                state.activeSlideIndex = idx - 1;
                renderApp();
            }
        });

        btnMoveDown.addEventListener('click', () => {
            const idx = state.activeSlideIndex;
            if (idx < state.slides.length - 1) {
                const temp = state.slides[idx + 1];
                state.slides[idx + 1] = state.slides[idx];
                state.slides[idx] = temp;
                state.activeSlideIndex = idx + 1;
                renderApp();
            }
        });

        btnDeleteSlide.addEventListener('click', () => {
            if (state.slides.length <= 1) return;
            state.slides.splice(state.activeSlideIndex, 1);
            if (state.activeSlideIndex >= state.slides.length) {
                state.activeSlideIndex = state.slides.length - 1;
            }
            renderApp();
            showToast('Skaidrė pašalinta.', 'info');
        });

