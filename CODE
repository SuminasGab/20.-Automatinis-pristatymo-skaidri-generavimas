        // 8. FULLSCREEN PRESENTATION MODE
        // =========================================================================
        const presentationOverlay = document.getElementById('presentation-overlay');
        const presentSlideStage = document.getElementById('present-slide-stage');
        const presentCounter = document.getElementById('present-counter');

        function renderPresentationSlide() {
            const total = state.slides.length;
            const slide = state.slides[state.activeSlideIndex];
            presentCounter.textContent = `${state.activeSlideIndex + 1} / ${total}`;
            presentSlideStage.innerHTML = buildSlideHTML(slide, state.activeSlideIndex, total, state.currentTheme, { editable: false });
        }

        function enterPresentationMode() {
            state.isPresenting = true;
            presentationOverlay.classList.remove('hidden');
            renderPresentationSlide();
            if (document.documentElement.requestFullscreen) {
                document.documentElement.requestFullscreen().catch(() => {});
            }
        }

        function exitPresentationMode() {
            state.isPresenting = false;
            presentationOverlay.classList.add('hidden');
            if (document.fullscreenElement && document.exitFullscreen) {
                document.exitFullscreen().catch(() => {});
            }
            renderApp();
        }

        document.getElementById('btn-present-mode').addEventListener('click', enterPresentationMode);
        document.getElementById('btn-exit-present').addEventListener('click', exitPresentationMode);

        document.getElementById('btn-present-prev').addEventListener('click', () => {
            if (state.activeSlideIndex > 0) {
                state.activeSlideIndex--;
                renderPresentationSlide();
            }
        });

        document.getElementById('btn-present-next').addEventListener('click', () => {
            if (state.activeSlideIndex < state.slides.length - 1) {
                state.activeSlideIndex++;
                renderPresentationSlide();
            }
        });

        // Keyboard navigation in Presentation Mode
        document.addEventListener('keydown', (e) => {
            if (!state.isPresenting) return;
            if (e.key === 'ArrowRight' || e.key === 'Space' || e.key === 'PageDown') {
                e.preventDefault();
                if (state.activeSlideIndex < state.slides.length - 1) {
                    state.activeSlideIndex++;
                    renderPresentationSlide();
                }
            } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
                e.preventDefault();
                if (state.activeSlideIndex > 0) {
                    state.activeSlideIndex--;
                    renderPresentationSlide();
                }
            } else if (e.key === 'Escape') {
                exitPresentationMode();
            }
        });

        document.addEventListener('fullscreenchange', () => {
            if (!document.fullscreenElement && state.isPresenting) {
