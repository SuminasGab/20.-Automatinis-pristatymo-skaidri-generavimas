        // =========================================================================
        // 5. RENDER WORKSPACE (Thumbnails + Active Slide + Speaker Notes)
        // =========================================================================
        function renderApp() {
            const total = state.slides.length;
            if (state.activeSlideIndex >= total) {
                state.activeSlideIndex = Math.max(0, total - 1);
            }
            const activeSlide = state.slides[state.activeSlideIndex];

            // Update indicators
            totalSlidesLabel.textContent = total;
            activeSlideIndicator.textContent = `Skaidrė ${state.activeSlideIndex + 1} iš ${total}`;
            activeLayoutSelect.value = activeSlide.layout || 'bullets';
            speakerNotesInput.value = activeSlide.speakerNotes || '';

            // Update order buttons state
            btnMoveUp.disabled = state.activeSlideIndex === 0;
            btnMoveDown.disabled = state.activeSlideIndex === total - 1;
            btnDeleteSlide.disabled = total <= 1;

            // Render Active Slide Canvas (Editable)
            slideCanvasWrapper.innerHTML = buildSlideHTML(
                activeSlide,
                state.activeSlideIndex,
                total,
                state.currentTheme,
                { editable: true }
            );

            // Attach inline edit listeners
            attachInlineEditListeners();

            // Render Thumbnails Filmstrip
            thumbnailsList.innerHTML = state.slides.map((slide, idx) => {
                const isActive = idx === state.activeSlideIndex;
                return `
                    <div data-thumb-index="${idx}" class="thumb-item group cursor-pointer rounded-xl p-1.5 transition-all shrink-0 w-40 lg:w-full ${isActive ? 'bg-indigo-50 ring-2 ring-indigo-600 shadow-xs' : 'bg-white hover:bg-slate-50 border border-slate-200'}">
                        <div class="flex items-center justify-between px-1 mb-1">
                            <span class="text-[11px] font-bold ${isActive ? 'text-indigo-700' : 'text-slate-500'}">${idx + 1}. Skaidrė</span>
                            <span class="text-[10px] text-slate-400 truncate max-w-[90px]">${slide.layout}</span>
                        </div>
                        <div class="w-full slide-aspect rounded-lg overflow-hidden relative border border-black/10 pointer-events-none">
                            <div class="w-[400%] h-[400%] origin-top-left scale-[0.25]">
                                ${buildSlideHTML(slide, idx, total, state.currentTheme, { editable: false, isThumbnail: true })}
                            </div>
                        </div>
                    </div>
                `;
            }).join('');

            // Attach thumbnail click events
            document.querySelectorAll('.thumb-item').forEach(el => {
                el.addEventListener('click', () => {
                    state.activeSlideIndex = parseInt(el.getAttribute('data-thumb-index'), 10);
                    renderApp();
                });
            });

            // Re-render fullscreen slide if open
            if (state.isPresenting) {
                renderPresentationSlide();
            }
        }

        function attachInlineEditListeners() {
            const activeSlide = state.slides[state.activeSlideIndex];

            // Editable fields (title, subtitle, statValue, statLabel)
            slideCanvasWrapper.querySelectorAll('[data-field]').forEach(el => {
                el.addEventListener('input', () => {
                    const field = el.getAttribute('data-field');
                    activeSlide[field] = el.innerText.trim();
                    updateThumbnailPreviewOnly();
                });
            });

            // Editable bullets
            slideCanvasWrapper.querySelectorAll('[data-bullet-index]').forEach(el => {
                el.addEventListener('input', () => {
                    const bIdx = parseInt(el.getAttribute('data-bullet-index'), 10);
                    if (Array.isArray(activeSlide.bullets)) {
                        activeSlide.bullets[bIdx] = el.innerText.trim();
                        updateThumbnailPreviewOnly();
                    }
                });
            });
        }

        function updateThumbnailPreviewOnly() {
            const idx = state.activeSlideIndex;
            const thumbEl = document.querySelector(`.thumb-item[data-thumb-index="${idx}"] .scale-\\[0\\.25\\]`);
            if (thumbEl) {
                thumbEl.innerHTML = buildSlideHTML(state.slides[idx], idx, state.slides.length, state.currentTheme, { editable: false });
            }
        }

        // =========================================================================
        // 6. GEMINI API INTEGRATION WITH STRUCTURED JSON & FALLBACK
        // =========================================================================
        async function generateSlidesWithAI(topic, count, style) {
            const apiKey = ""; // Canvas runtime automatically injects API key
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

            const systemPrompt = `Tu esi profesionalus pristatymų dizaineris ir turinio strategas. 
Tavo užduotis – pagal vartotojo pateiktą temą arba šaltinio tekstą sukurti lygiai ${count} skaidrių pristatymą lietuvių kalba.
Stilius ir auditorija: ${style}.

Taisyklės:
1. Visas tekstas privalo būti taisyklinga, natūralia lietuvių kalba.
2. Pirmoji skaidrė PRIVALO turėti layout: "title".
3. Paskutinė skaidrė PRIVALO turėti layout: "conclusion".
4. Tarpinės skaidrės turi įvairuoti tarp layout: "bullets", "two-column" ir "stat".
5. Kiekvienoje skaidrėje pateik 3 arba 4 trumpus, aiškius ir įtaigius punktus (bullets).
6. Jei layout yra "stat", nurodyk įtaigų skaičių ar procentą lauke "statValue" (pvz., "82%", "3.5x", "2026") ir trumpą paaiškinimą lauke "statLabel".
7. Kiekvienai skaidrei parašyk naudingas, natūralias pranešėjo pastabas (speakerNotes) lietuvių kalba.`;

            const payload = {
                contents: [{
                    parts: [{
                        text: `Sukurk ${count} skaidrių pristatymą (${style}) pagal šią temą arba tekstą:\n\n${topic}`
                    }]
                }],
                systemInstruction: {
                    parts: [{ text: systemPrompt }]
                },
                generationConfig: {
                    responseMimeType: "application/json",
                    responseSchema: {
                        type: "ARRAY",
                        items: {
                            type: "OBJECT",
                            properties: {
                                title: { type: "STRING" },
                                subtitle: { type: "STRING" },
                                layout: {
                                    type: "STRING",
                                    enum: ["title", "bullets", "two-column", "stat", "conclusion"]
                                },
                                bullets: {
                                    type: "ARRAY",
                                    items: { type: "STRING" }
                                },
                                statValue: { type: "STRING" },
                                statLabel: { type: "STRING" },
                                speakerNotes: { type: "STRING" }
                            },
                            required: ["title", "subtitle", "layout", "bullets", "statValue", "statLabel", "speakerNotes"]
                        }
                    }
                }
            };

            // Retry with exponential backoff
            const maxRetries = 3;
            let delay = 1000;

            for (let attempt = 0; attempt < maxRetries; attempt++) {
                try {
                    const controller = new AbortController();
                    const timeoutId = setTimeout(() => controller.abort(), 25000);

                    const response = await fetch(apiUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload),
                        signal: controller.signal
                    });

                    clearTimeout(timeoutId);

                    if (!response.ok) {
                        throw new Error(`HTTP error: ${response.status}`);
                    }

                    const result = await response.json();
                    const rawText = result?.candidates?.[0]?.content?.parts?.[0]?.text;
                    if (!rawText) throw new Error('Empty response');

                    const parsedSlides = JSON.parse(rawText);
                    if (Array.isArray(parsedSlides) && parsedSlides.length > 0) {
                        return parsedSlides.slice(0, count);
                    }
                    throw new Error('Invalid slides array');
                } catch (err) {
                    if (attempt === maxRetries - 1) {
                        throw err;
                    }
                    await new Promise(res => setTimeout(res, delay));
                    delay *= 2;
                }
            }
        }

