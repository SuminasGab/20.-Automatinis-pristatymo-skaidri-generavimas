                        </div>
                        <div class="min-w-0">
                            <div class="text-xs sm:text-sm font-semibold text-slate-900 truncate">Šviesus verslo</div>
                            <div class="text-[11px] text-slate-500 hidden lg:block">Klasikinis baltas su aukso detalėmis</div>
                        </div>
                    </button>

                    <!-- Theme 3: Kūrybiškas smaragdas -->
                    <button type="button" data-theme="emerald-editorial" class="theme-option flex items-center gap-3 p-2.5 rounded-xl border border-slate-200 hover:border-slate-300 bg-white text-left transition">
                        <div class="w-8 h-8 rounded-lg bg-emerald-950 border border-emerald-800 flex items-center justify-center shrink-0 shadow-xs">
                            <span class="w-3 h-3 rounded-full bg-amber-300"></span>
                        </div>
                        <div class="min-w-0">
                            <div class="text-xs sm:text-sm font-semibold text-slate-900 truncate">Kūrybiškas smaragdas</div>
                            <div class="text-[11px] text-slate-500 hidden lg:block">Smaragdo ir šiltos kreminės spalvos</div>
                        </div>
                    </button>
                </div>
            </div>

            <!-- Generate Primary Button -->
            <div class="pt-1 mt-auto">
                <button id="btn-generate" type="button" class="w-full py-3 px-4 rounded-xl bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-700 hover:to-blue-700 text-white font-semibold text-sm shadow-md shadow-indigo-500/20 flex items-center justify-center gap-2 transition active:scale-[0.99] cursor-pointer">
                    <i data-lucide="sparkles" class="w-4 h-4"></i>
                    <span id="btn-generate-text">Generuoti skaidres</span>
