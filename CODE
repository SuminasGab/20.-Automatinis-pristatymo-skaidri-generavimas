                        </select>
                    </div>

                    <!-- Slide Order & Delete Controls -->
                    <div class="flex items-center gap-1.5">
                        <button id="btn-move-up" type="button" title="Perkelti aukštyn" class="p-1.5 rounded-lg bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 disabled:opacity-40 transition">
                            <i data-lucide="arrow-up" class="w-4 h-4"></i>
                        </button>
                        <button id="btn-move-down" type="button" title="Perkelti žemyn" class="p-1.5 rounded-lg bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 disabled:opacity-40 transition">
                            <i data-lucide="arrow-down" class="w-4 h-4"></i>
                        </button>
                        <button id="btn-delete-slide" type="button" title="Ištrinti skaidrę" class="p-1.5 rounded-lg bg-white border border-slate-200 text-rose-600 hover:bg-rose-50 disabled:opacity-40 transition">
