            <button id="btn-present-next" type="button" class="p-3 rounded-full bg-white/15 hover:bg-white/25 backdrop-blur-md text-white transition">
                <i data-lucide="chevron-right" class="w-5 h-5"></i>
            </button>
        </div>
    </div>

    <!-- Hidden Print Container for PDF Export -->
    <div id="print-container" class="hidden"></div>

    <script>
        // =========================================================================
        // 1. STATE & THEME DEFINITIONS
        // =========================================================================
        const THEMES = {
            'dark-modern': {
                name: 'Tamsus modernus',
                bgClass: 'bg-gradient-to-br from-slate-950 via-slate-900 to-indigo-950 text-white',
                cardClass: 'bg-white/5 border border-white/10 backdrop-blur-xs',
                accentText: 'text-cyan-400',
                accentBg: 'bg-cyan-500',
                badgeClass: 'bg-cyan-500/15 text-cyan-300 border border-cyan-400/30',
                mutedText: 'text-slate-300',
                bulletDot: 'bg-cyan-400 shadow-[0_0_8px_rgba(34,211,238,0.6)]',
                divider: 'border-white/10',
                statCard: 'bg-gradient-to-br from-cyan-500/20 to-indigo-500/20 border border-cyan-400/30'
            },
            'light-corporate': {
                name: 'Šviesus verslo',
                bgClass: 'bg-gradient-to-br from-white via-slate-50 to-amber-50/40 text-slate-900',
                cardClass: 'bg-white border border-slate-200/90 shadow-xs',
                accentText: 'text-amber-600',
                accentBg: 'bg-slate-900',
                badgeClass: 'bg-amber-100/80 text-amber-800 border border-amber-300/60',
                mutedText: 'text-slate-600',
                bulletDot: 'bg-amber-500',
                divider: 'border-slate-200',
                statCard: 'bg-slate-900 text-white border border-slate-800'
            },
            'emerald-editorial': {
                name: 'Kūrybiškas smaragdas',
                bgClass: 'bg-gradient-to-br from-[#062c22] via-[#09382b] to-[#0d4a3a] text-[#fdfbf7]',
                cardClass: 'bg-[#fdfbf7]/8 border border-[#fdfbf7]/15',
                accentText: 'text-amber-300',
                accentBg: 'bg-amber-300',
                badgeClass: 'bg-amber-300/15 text-amber-200 border border-amber-300/30',
                mutedText: 'text-emerald-100/85',
                bulletDot: 'bg-amber-300',
                divider: 'border-emerald-100/15',
                statCard: 'bg-[#fdfbf7] text-[#062c22] border border-amber-200'
            }
        };

        // Initial Default Deck in Lithuanian
        let state = {
            currentTheme: 'dark-modern',
            activeSlideIndex: 0,
            isPresenting: false,
            slides: [
