        <div class="absolute top-4 left-4 right-4 flex items-center justify-between z-10 opacity-80 hover:opacity-100 transition">
            <span id="present-counter" class="px-3 py-1.5 rounded-full bg-white/15 backdrop-blur-md text-white text-xs font-semibold">
                1 / 5
            </span>
            <button id="btn-exit-present" type="button" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-white/15 hover:bg-white/25 backdrop-blur-md text-white text-xs font-semibold transition">
                <i data-lucide="x" class="w-4 h-4"></i>
                <span>Išeiti (ESC)</span>
