                </div>

                <!-- Add Slide Button -->
                <button id="btn-add-slide" type="button" class="min-w-[140px] lg:min-w-0 lg:w-full py-2.5 px-3 rounded-xl border-2 border-dashed border-slate-300 hover:border-indigo-400 hover:bg-indigo-50/50 text-slate-500 hover:text-indigo-600 text-xs font-semibold flex items-center justify-center gap-1.5 transition shrink-0">
