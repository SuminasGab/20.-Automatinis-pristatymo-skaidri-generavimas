                <!-- 16:9 Widescreen Slide Stage -->
                <div class="max-w-4xl w-full mx-auto">
                    <div id="slide-canvas-wrapper" class="w-full slide-aspect rounded-2xl shadow-xl border border-slate-200/80 overflow-hidden relative transition-all duration-300">
