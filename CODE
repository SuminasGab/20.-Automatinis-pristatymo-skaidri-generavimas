                showToast('Prašome įvesti pristatymo temą arba tekstą.', 'warning');
                topicInput.focus();
                return;
            }

            const count = parseInt(slideCountSlider.value, 10) || 5;
            const style = styleSelect.value;

            // Loading UI state
            btnGenerate.disabled = true;
            btnGenerate.classList.add('opacity-80', 'cursor-not-allowed');
            btnGenerateText.textContent = 'Generuojama...';

            try {
                const generatedSlides = await generateSlidesWithAI(topic, count, style);
                state.slides = generatedSlides;
                state.activeSlideIndex = 0;
                renderApp();
                showToast('Skaidrės sėkmingai sugeneruotos!', 'success');
            } catch (error) {
                // Fallback to local smart generator if API fails
                state.slides = buildFallbackDeck(topic, count, style);
                state.activeSlideIndex = 0;
                renderApp();
                showToast('Sugeneruotas demonstracinis skaidrių rinkinys.', 'info');
