                    </div>
                    <textarea id="speaker-notes-input" rows="2" placeholder="Įrašykite pastabas, kurias sakysite pristatydami šią skaidrę..." class="w-full text-sm text-slate-700 bg-slate-50/70 rounded-xl p-3 border border-slate-200/80 focus:border-indigo-400 focus:bg-white outline-none transition resize-y"></textarea>
                </div>

            </div>
